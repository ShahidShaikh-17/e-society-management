<!-- Modern Profile -->
<%- include('partials/modern-header', {pageTitle: 'Profile', pageActive: 'profile', isAdmin: isAdmin}) %>

<section class="page-header" data-aos="fade-down">
  <div class="container">
    <h1 class="page-title">Profile</h1>
    <p class="page-subtitle">Manage your personal information and settings</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="text-center mb-4" data-aos="fade-up">
      <a href="/editProfile" class="btn-modern">
        <i class="fas fa-edit me-2"></i>Edit Profile
      </a>
    </div>

    <div class="row">
      <div class="col-lg-6">
        <div class="modern-card" data-aos="fade-up">
          <div class="text-center mb-4">
            <div class="profile-avatar mb-3" style="width: 100px; height: 100px; background: #1E3A8A; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
              <i class="fas fa-user text-white" style="font-size: 3rem;"></i>
            </div>
            <h3 style="color: #2d3748; font-weight: 700;">Personal Information</h3>
          </div>

          <div class="profile-details">
            <div class="info-item mb-3 p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-user text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Name</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600;"><%= resident.firstName %> <%= resident.lastName %></p>
                </div>
              </div>
            </div>

            <div class="info-item mb-3 p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-phone text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Phone</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600;"><%= resident.phoneNumber || resident.mobileNumber || '-' %></p>
                </div>
              </div>
            </div>

            <div class="info-item mb-3 p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-home text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Flat</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600;"><%= resident.flatNumber %></p>
                </div>
              </div>
            </div>

            <div class="info-item p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-envelope text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Email</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600; word-break: break-all;"><%= resident.username %></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="modern-card" data-aos="fade-up" data-aos-delay="100">
          <div class="text-center mb-4">
            <div class="society-icon mb-3" style="width: 100px; height: 100px; background: #1E3A8A; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
              <i class="fas fa-city text-white" style="font-size: 3rem;"></i>
            </div>
            <h3 style="color: #2d3748; font-weight: 700;">Society Information</h3>
          </div>

          <div class="society-details">
            <div class="info-item mb-3 p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-building text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Society Name</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600;"><%= society.societyName %></p>
                </div>
              </div>
            </div>

            <div class="info-item p-3" style="background: #f8f9fa; border-radius: 10px;">
              <div class="d-flex align-items-center">
                <div class="info-icon me-3" style="width: 40px; height: 40px; background: #1E3A8A; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                  <i class="fas fa-map-marker-alt text-white"></i>
                </div>
                <div>
                  <p class="mb-0 text-muted" style="font-size: 0.9rem;">Address</p>
                  <p class="mb-0" style="color: #2d3748; font-weight: 600;">
                    <%= society.societyAddress.address %>, <%= society.societyAddress.city %>, 
                    <%= society.societyAddress.district %>-<%= society.societyAddress.postalCode %>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>