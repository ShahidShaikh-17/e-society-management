<!-- Modern Residents -->
<%- include('partials/modern-header', {pageTitle: 'Residents', pageActive: 'residents', isAdmin: typeof isAdmin !== 'undefined' ? isAdmin : false}) %>

<section class="page-header" data-aos="fade-down">
  <div class="container">
    <h1 class="page-title">Residents</h1>
    <p class="page-subtitle">View and manage resident information and contact details</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <% if(isAdmin && appliedResidents && appliedResidents.length){ %>
      <div class="modern-card mb-4" data-aos="fade-up">
        <div class="text-center mb-4">
          <div class="approval-icon mb-3" style="width: 80px; height: 80px; background: #1E3A8A; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
            <i class="fas fa-user-check text-white" style="font-size: 2rem;"></i>
          </div>
          <h3 style="color: #2d3748; font-weight: 700;">Approve New Residents</h3>
          <p class="text-muted">Review and approve resident applications</p>
        </div>
        
        <% appliedResidents.forEach(user => { %>
          <form action="/approveResident" method="POST" class="mb-3">
            <div class="resident-approval-card p-3" style="background: #f8f9fa; border-radius: 15px; border: 1px solid #e9ecef;">
              <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <div class="resident-avatar me-3" style="width: 50px; height: 50px; background: #1E3A8A; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                    <%= (((user.firstName?.charAt(0) || '') + (user.lastName?.charAt(0) || '')).toUpperCase() || 'U') %>
                  </div>
                  <div>
                    <h5 class="mb-1" style="color: #2d3748; font-weight: 600;"><%= (user.firstName || '') %> <%= (user.lastName || '') %></h5>
                    <p class="mb-0 text-muted">Flat: <%= user.flatNumber %> | <%= (user.role === 'guard') ? 'Guard' : (user.occupancyStatus || 'Owner') %></p>
                  </div>
                </div>
                <div class="d-flex gap-2">
                  <button type="submit" name="validate[<%= user._id %>]" value="approved" class="btn-modern btn-success" style="padding: 8px 16px; font-size: 0.9rem;">
                    <i class="fas fa-check me-1"></i>Approve
                  </button>
                  <button type="submit" name="validate[<%= user._id %>]" value="declined" class="btn-modern" style="padding: 8px 16px; font-size: 0.9rem;">
                    <i class="fas fa-times me-1"></i>Decline
                  </button>
                </div>
              </div>
            </div>
          </form>
        <% }) %>
      </div>
    <% } %>

    <div class="text-center mb-4" data-aos="fade-up">
      <h2 style="color: #2d3748; font-weight: 700;">Residents of <%= societyName %></h2>
      <p class="text-muted">Complete resident directory</p>
      <p class="text-muted mb-0">
        Total Residents: <%= (societyResidents || []).length %>
      </p>
    </div>

    <div class="row g-4" data-aos="fade-up">
      <% (societyResidents || []).forEach((resident) => { %>
        <div class="col-lg-4 col-md-6">
          <div class="modern-card text-center">
            <div class="resident-avatar mb-3" style="width: 80px; height: 80px; background: #1E3A8A; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
              <%= (((resident.firstName?.charAt(0) || '') + (resident.lastName?.charAt(0) || '')).toUpperCase() || 'U') %>
            </div>
            <h4 style="color: #2d3748; font-weight: 700; margin-bottom: 10px;">
              <%= (resident.firstName || '') %> <%= (resident.lastName || '') %>
              <% if(resident.isAdmin) { %>
                <span class="badge bg-primary ms-2">Admin</span>
              <% } %>
            </h4>
            <div class="resident-details">
              <p class="mb-2" style="color: #718096;">
                <i class="fas fa-home me-2"></i>Flat: <%= resident.flatNumber %>
              </p>
              <p class="mb-2" style="color: #718096;">
                <i class="fas fa-user-tag me-2"></i><%= (resident.role === 'guard') ? 'Guard' : (resident.occupancyStatus || 'Owner') %>
              </p>
              <p class="mb-0" style="color: #718096;">
                <i class="fas fa-phone me-2"></i><%= (typeof isAdmin !== 'undefined' && isAdmin) ? (resident.phoneNumber || resident.mobileNumber || 'Hidden') : 'Hidden' %>
              </p>
            </div>
            <% if(typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div class="mt-3">
              <% if((resident.phoneNumber || resident.mobileNumber) && (!resident.isAdmin || (typeof currentUser === 'undefined') || (resident._id.toString() !== currentUser._id.toString()))) { %>
                <a href="tel:<%= resident.phoneNumber || resident.mobileNumber %>" class="btn btn-sm btn-outline-success">
                  <i class="fas fa-phone me-1"></i>Contact
                </a>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <% if((societyResidents || []).length === 0){ %>
      <div class="text-center py-5" data-aos="fade-up">
        <div class="empty-state" style="max-width: 400px; margin: 0 auto;">
          <div class="empty-icon mb-3" style="width: 100px; height: 100px; background: #1E3A8A; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
            <i class="fas fa-users text-white" style="font-size: 3rem;"></i>
          </div>
          <h3 style="color: #2d3748; font-weight: 700;">No Residents Yet</h3>
          <p class="text-muted">No residents have been added to the society yet.</p>
        </div>
      </div>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>