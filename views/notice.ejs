<!-- Modern New Notice -->
<%- include('partials/modern-header', {pageTitle: 'Create Notice', pageActive: 'noticeboard', isAdmin: typeof isAdmin !== 'undefined' ? isAdmin : false}) %>

<section class="page-header" data-aos="fade-down">
  <div class="container">
    <h1 class="page-title">Create Notice</h1>
    <p class="page-subtitle">Share important announcements with the community</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <div class="modern-card" data-aos="fade-up">
          <div class="text-center mb-4">
            <div class="form-icon mb-3" style="width: 80px; height: 80px; background: #1E3A8A; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
              <i class="fas fa-bullhorn text-white" style="font-size: 2rem;"></i>
            </div>
            <h3 style="color: #2d3748; font-weight: 700;">New Notice</h3>
            <p class="text-muted">Fill in the details to create a new notice</p>
          </div>

          <form action="/notice" method="POST">
            <div class="form-group mb-4">
              <label for="subject" style="color: #4a5568; font-weight: 600; margin-bottom: 8px; display: block;">
                <i class="fas fa-heading me-2"></i>Subject
              </label>
              <input name="subject" type="text" class="form-control" id="subject" required
                     minlength="3" maxlength="120"
                     style="border: 2px solid #e9ecef; border-radius: 10px; padding: 12px 15px; font-size: 15px; transition: all 0.3s ease;"
                     placeholder="Enter notice subject">
            </div>

            <div class="form-group mb-4">
              <label for="details" style="color: #4a5568; font-weight: 600; margin-bottom: 8px; display: block;">
                <i class="fas fa-align-left me-2"></i>Details
              </label>
              <textarea name="details" class="form-control" id="details" rows="6" required
                        minlength="5" maxlength="2000"
                        style="border: 2px solid #e9ecef; border-radius: 10px; padding: 12px 15px; font-size: 15px; transition: all 0.3s ease; resize: vertical;"
                        placeholder="Enter notice details"></textarea>
            </div>

            <div class="d-flex gap-3">
              <button type="submit" class="btn-modern flex-fill">
                <i class="fas fa-paper-plane me-2"></i>Submit Notice
              </button>
              <a href="/noticeboard" class="btn-modern btn-warning flex-fill">
                <i class="fas fa-times me-2"></i>Cancel
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>