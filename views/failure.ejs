<!-- Modern Failure Page -->
<%- include('partials/modern-header', {pageTitle: 'Failed', pageActive: 'bill', isAdmin: typeof isAdmin !== 'undefined' ? isAdmin : false}) %>

<section class="page-header" data-aos="fade-down">
  <div class="container">
    <h1 class="page-title">Failed</h1>
    <p class="page-subtitle">There was an issue processing your request</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="modern-card" data-aos="fade-up">
      <div class="text-center mb-4">
        <div class="failure-icon mb-4" style="width: 120px; height: 120px; background: #dc3545; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
          <i class="fas fa-times text-white" style="font-size: 4rem;"></i>
        </div>
        <h2 style="color: #dc3545; font-weight: 800; margin-bottom: 10px;">Failed</h2>
        <p style="color: #6c757d; font-size: 1.1rem;"><%= message %></p>
      </div>

      <div class="text-center">
        <% if(href) { %>
        <a href="<%= href %>" class="btn-modern btn-danger me-3">
          <i class="fas fa-redo me-2"></i>Try Again
        </a>
        <% } %>
        <% if(hrefSecondary && buttonSecondary) { %>
        <a href="<%= hrefSecondary %>" class="btn-modern btn-success me-3">
          <i class="fas fa-<%= buttonSecondary.toLowerCase().includes('register') ? 'user-plus' : 'sign-in-alt' %> me-2"></i><%= buttonSecondary %>
        </a>
        <% } %>
        <a href="/" class="btn-modern">
          <i class="fas fa-home me-2"></i>Home
        </a>
      </div>

      <% if(messageSecondary) { %>
      <div class="text-center mt-4">
        <p style="color: #6c757d;"><%= messageSecondary %></p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>