<%- include('partials/modern-header', {pageTitle: 'Account Status', pageActive: 'home'}) %>

<section class="page-header" data-aos="fade-down">
  <div class="container">
    <h1 class="page-title">Account Status</h1>
    <p class="page-subtitle">Your account needs admin approval</p>
  </div>
</section>

<section class="content-section">
  <div class="container">
    <div class="modern-card mx-auto" style="max-width: 720px;" data-aos="fade-up">
      <div class="text-center">
        <div class="mb-3" style="font-size: 3.5rem; color: #1E3A8A;">
          <i class="fas <%= icon %>"></i>
        </div>
        <h2 class="mb-2" style="font-weight: 800; color:#0f172a;">Request Pending</h2>
        <p class="text-muted mb-4">Your request is under review. Please wait for admin approval.</p>

        <div class="d-flex gap-2 justify-content-center flex-wrap">
          <a href="/newRequest" class="btn-modern">
            <i class="fas fa-edit me-2"></i>New Request
          </a>
          <a href="/logout" class="btn btn-outline-danger">
            <i class="fas fa-sign-out-alt me-2"></i>Logout
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>