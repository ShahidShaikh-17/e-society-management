      data-ad-client="ca-pub-6343650725036009"
      data-ad-slot="3263921922"
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </div>

  <section class="banner" id="banner" style="background: url('https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80') center/cover; min-height: 100vh; display: flex; align-items: center; position: relative;">
    <div class="content text-center text-white">
      <div class="container">
        <h1 data-aos="fade-right" class="display-1 fw-bold mb-4" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.5);">E-Society</h1>
        <p data-aos="fade-left" class="lead mb-5" style="text-shadow: 1px 1px 2px rgba(0,0,0,0.5); font-size: 1.3rem;">
          Simplify everyday living for your housing society. Manage accounts and payments, 
          resolve complaints and keep the community up-to-date with all that's going on in society.
        </p>
        <div data-aos="zoom-in">
          <a class="btn btn-lg me-3 px-5 py-3" href="/login" role="button" style="min-width: 160px; background: #1E3A8A; border: none; border-radius: 50px; box-shadow: 0 10px 25px rgba(30, 58, 138, 0.25); transition: all 0.3s ease; color: white; font-weight: 600;">
            <i class="fas fa-sign-in-alt me-2"></i>LOGIN
          </a>
          <a class="btn btn-lg me-3 px-5 py-3" href="/signup" role="button" style="min-width: 160px; background: #198754; border: none; border-radius: 50px; box-shadow: 0 10px 25px rgba(25, 135, 84, 0.25); transition: all 0.3s ease; color: white; font-weight: 600;">
            <i class="fas fa-user-plus me-2"></i>SIGN UP
          </a>
          <div class="mt-3">
            <a class="btn btn-lg px-5 py-3" href="/register" role="button" style="min-width: 260px; background: #ffffff; border: 2px solid #1E3A8A; border-radius: 50px; color: #1E3A8A; font-weight: 600; box-shadow: 0 8px 20px rgba(30, 58, 138, 0.15); transition: all 0.3s ease;">
              <i class="fas fa-building me-2"></i>SOCIETY & ADMIN REGISTER
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <br>
  <section class="py-5" id="deck" style="background: #F8FAFC;">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-dark" data-aos="fade-up">Why choose E-Society?</h2>
        <p class="lead text-muted" data-aos="fade-up">Modern solutions for modern communities</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4" data-aos="flip-up">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-primary">
                  <i class="fas fa-users fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Simple Connectivity</h5>
              <p class="card-text text-muted">Give your residents an easier way to connect. New accounts created will be approved by the society administrator for activation.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4" data-aos="flip-up" data-aos-delay="100">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-success">
                  <i class="fas fa-clipboard fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Hassle-free Communication</h5>
              <p class="card-text text-muted">Get the tools you need to keep everyone on the same page, notify about the events on the digital noticeboard.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4" data-aos="flip-up" data-aos-delay="200">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-warning">
                  <i class="fas fa-file-invoice-dollar fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Smart Money Management</h5>
              <p class="card-text text-muted">Residents can pay their dues online through our Integrated Payment Gateway. Instant E-Receipts is generated and their Dues get cleared off.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="row g-4 mt-2">
        <div class="col-md-4" data-aos="flip-down">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-info">
                  <i class="fas fa-comment fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Helpdesk Resolution</h5>
              <p class="card-text text-muted">Easily raise Maintenance Requests and track to Quick Closure, Provide comments & feedback.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4" data-aos="flip-down" data-aos-delay="100">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-danger">
                  <i class="fas fa-id-card fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Emergency Contacts</h5>
              <p class="card-text text-muted">Always, be prepared for emergencies. You can configure the Emergency Number list with numbers of your local police station, ambulance or pharmacy; accessible to everyone.</p>
            </div>
          </div>
        </div>
        <div class="col-md-4" data-aos="flip-down" data-aos-delay="200">
          <div class="card h-100 border-0 shadow-lg hover-card">
            <div class="card-body text-center p-4">
              <div class="mb-3">
                <div class="icon-circle bg-secondary">
                  <i class="fas fa-user-circle fa-2x text-white"></i>
                </div>
              </div>
              <h5 class="card-title fw-bold text-dark">Profile Management</h5>
              <p class="card-text text-muted">Provide flexibility to residents for managing and updating their user profile.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="stats" class="py-5" style="background: #1E3A8A; color: white; position: relative;">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="display-4 fw-bold" data-aos="zoom-in-up">Imagine the Possibilities in a Connected Community</h2>
        <p class="lead" data-aos="fade-up">Join thousands already using E-Society</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4 col-6" data-aos="zoom-in-down">
          <div class="stat-card text-center">
            <div class="mb-3">
              <div class="stat-icon">
                <i class="fas fa-city fa-3x"></i>
              </div>
            </div>
            <h3 class="fw-bold counter"><%= city %></h3>
            <p class="mb-0">Cities</p>
          </div>
        </div>
        <div class="col-md-4 col-6" data-aos="zoom-in-down" data-aos-delay="100">
          <div class="stat-card text-center">
            <div class="mb-3">
              <div class="stat-icon">
                <i class="fas fa-building fa-3x"></i>
              </div>
            </div>
            <h3 class="fw-bold counter"><%= society %></h3>
            <p class="mb-0">Housing Societies</p>
          </div>
        </div>
        <div class="col-md-4 col-6" data-aos="zoom-in-down" data-aos-delay="200">
          <div class="stat-card text-center">
            <div class="mb-3">
              <div class="stat-icon">
                <i class="fas fa-home fa-3x"></i>
              </div>
            </div>
            <h3 class="fw-bold counter"><%= user %></h3> 
            <p class="mb-0">Homes</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-5" style="background: #F8FAFC;" data-aos="fade-up" data-aos-anchor-placement="bottom-bottom">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="display-4 fw-bold text-dark" data-aos="fade-up">Reach Out</h2>
        <p class="lead text-muted" data-aos="fade-up">We'd love to hear from you</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-6">
          <div class="contact-card border-0 shadow-lg">
            <div class="card-body p-5">
              <form action="mailto:Shaikhshao.19@gmail.com" method="POST" enctype="text/plain">
                <div class="mb-3">
                  <input class="form-control form-control-lg" type="text" placeholder="Your Name" required name="Name">
                </div>
                <div class="mb-3">
                  <input class="form-control form-control-lg" type="email" placeholder="Your Email" required name="Email">
                </div>
                <div class="mb-3">
                  <textarea class="form-control form-control-lg" rows="4" placeholder="Your Message" required name="Message"></textarea>
                </div>
                <div class="text-center">
                  <button class="btn btn-primary btn-lg px-5 py-3" type="submit">
                    <i class="fas fa-paper-plane me-2"></i>Send Message
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

