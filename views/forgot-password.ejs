<!-- Forgot Password -->
<%- include('partials/modern-header', { pageTitle: 'Forgot Password', hideNav: true }) %>

<style>
  .spinner {
    display: none;
    width: 16px;
    height: 16px;
    border: 2px solid #ffffff;
    border-top: 2px solid transparent;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-left: 8px;
    vertical-align: middle;
  }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  .btn-reset.loading .spinner { display: inline-block; }
</style>

<section class="auth-shell">
  <div class="auth-card" style="max-width: 420px;">
    <div class="text-center mb-4">
      <div class="auth-logo-icon mb-3">
        <i class="fas fa-key"></i>
      </div>
      <h1 class="auth-title">Reset Password</h1>
      <p class="auth-subtitle">Enter your email address and we'll send you a link to reset your password</p>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success d-flex align-items-center" role="alert">
        <i class="fas fa-check-circle me-2"></i>
        <div><%= message %></div>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger d-flex align-items-center" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i>
        <div><%= message %></div>
      </div>
    <% } %>

    <form action="/forgot-password" method="POST" id="forgotForm">
      <div class="mb-3 position-relative">
        <i class="fas fa-envelope auth-input-icon"></i>
        <input type="email" name="email" class="form-control auth-input" id="email" placeholder="Email Address" required>
      </div>

      <button type="submit" class="btn btn-primary w-100 py-2 btn-reset" id="resetBtn">
        <i class="fas fa-paper-plane me-2"></i>Send Reset Link
        <span class="spinner"></span>
      </button>
    </form>

    <div class="text-center mt-3">
      <a href="/login" class="text-decoration-none" style="color:#1E3A8A;font-weight:700;">
        <i class="fas fa-arrow-left me-2"></i>Back to Login
      </a>
    </div>
  </div>
</section>

<script>
  document.getElementById('forgotForm').addEventListener('submit', function() {
    const resetBtn = document.getElementById('resetBtn');
    resetBtn.classList.add('loading');
    resetBtn.disabled = true;
  });
</script>

<%- include('partials/footer') %>
